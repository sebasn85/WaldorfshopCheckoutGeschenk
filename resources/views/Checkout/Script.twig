<script>
(function(){
'use strict';
var root,box,status,state,busy=false;
async function request(method,body){
 var headers={'Accept':'application/json','Accept-Language':document.documentElement.lang||'de'};
 if(body){var csrf=document.getElementById('csrf-token');if(!csrf)throw new Error('Bitte lade die Kasse neu.');headers['Content-Type']='application/json';headers['X-CSRF-TOKEN']=csrf.value;}
 var response=await fetch('/rest/waldorfshop/checkout-gift',{method:method,credentials:'same-origin',cache:'no-store',headers:headers,body:body?JSON.stringify(body):undefined});
 var envelope=await response.json();if(!response.ok||!envelope.data||typeof envelope.data.eligible!=='boolean')throw new Error('Die Geschenkauswahl konnte nicht gespeichert werden. Bitte versuche es erneut.');return envelope.data;
}
function render(){var picture=root.querySelector('[data-gift-image]');if(state.image){if(picture.getAttribute('src')!==state.image)picture.src=state.image;picture.hidden=false;}else{picture.hidden=true;picture.removeAttribute('src');}root.hidden=!state.enabled||!state.eligible;box.checked=state.selected;box.disabled=busy||!state.eligible;root.querySelector('[data-gift-name]').textContent=state.name;status.textContent=state.selected?'Ausgewählt: Dein Geschenk wird der Bestellung kostenlos hinzugefügt.':'';}
async function refresh(){if(busy)return;busy=true;box.disabled=true;try{state=await request('GET');render();}catch(e){if(root&&!root.hidden){box.disabled=true;status.textContent=e.message;}}finally{busy=false;if(state)box.disabled=!state.eligible;}}
async function change(){if(busy||!state)return;var desired=box.checked;busy=true;box.disabled=true;status.textContent='Auswahl wird gespeichert …';
 try{state=await request('POST',{selected:desired,basketId:state.basketId});render();}catch(e){box.checked=state.selected;status.textContent=e.message;}finally{busy=false;box.disabled=!state.eligible;}}
function start(){root=document.querySelector('[data-ws-checkout-gift]');if(!root)return;box=root.querySelector('input');status=root.querySelector('[data-gift-status]');box.addEventListener('change',change);root.querySelector('[data-gift-image]').addEventListener('error',function(){this.hidden=true;});refresh();document.addEventListener('visibilitychange',function(){if(!document.hidden)refresh();});
 if(window.jQuery)window.jQuery(document).on('ajaxComplete.wsCheckoutGift',function(event,xhr,settings){if(settings&&/\/rest\/io\/(basket|checkout)/.test(settings.url))refresh();});
 document.addEventListener('click',function(e){if(busy&&e.target.closest('[data-testing="place-order"],.place-order')){e.preventDefault();e.stopImmediatePropagation();}},true);
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();
})();
</script>
